{
    email {$ACME_EMAIL}
    # HTTP/1.1 and HTTP/2 only: HTTP/3 runs over UDP, which many VPNs and proxies drop, and the browser then stalls before it falls back.
    servers {
        protocols h1 h2
    }
}

{$APP_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 525000000
    }
    redir /calendar /calendar/ 308
    handle_path /calendar/* {
        reverse_proxy campus-day-bot:8765
    }
    # Test platform «Инфокод · КР» (separate project /opt/infocode-kr on the same Docker network).
    redir /kr /kr/ 308
    handle_path /kr/* {
        reverse_proxy kr:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        reverse_proxy web:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        }
    }
}

# www goes to the main name (it needs a DNS A record www → this server; until then Caddy only retries the certificate).
www.{$APP_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} 308
}
