    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 525000000
    }
    handle_path /calendar/* {
        reverse_proxy campus-day-bot:8765
    }
    handle {
        reverse_proxy web:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        }
    }
}
